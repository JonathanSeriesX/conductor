<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Open and save panels (Attach Files, Save As) need this; without it the panel never appears. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Puts accounts in the data protection keychain (see Keychain in JiraClient.swift). Needs a signing team,
	     which Release builds on CI do not have, hence a separate file. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)org.evgenii.conductor</string>
	</array>
</dict>
</plist>
