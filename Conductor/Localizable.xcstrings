    "Attach files (⌥⌘A). You can also drop them anywhere or paste an image." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرفاق ملفات (⌥⌘A). يمكنك أيضًا إفلاتها في أي مكان أو لصق صورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien anhängen (⌥⌘A). Sie können sie auch an beliebiger Stelle ablegen oder ein Bild einsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjunta archivos (⌥⌘A). También puedes soltarlos en cualquier parte o pegar una imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joindre des fichiers (⌥⌘A). Vous pouvez aussi les déposer n’importe où ou coller une image."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें अटैच करें (⌥⌘A)। आप उन्हें कहीं भी ड्रॉप कर सकते हैं या कोई इमेज पेस्ट कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega file (⌥⌘A). Puoi anche trascinarli in un punto qualsiasi o incollare un’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを添付します（⌥⌘A）。どこにでもドロップしたり、画像をペーストしたりすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 첨부합니다(⌥⌘A). 아무 곳에나 드롭하거나 이미지를 붙여넣을 수도 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Załącz pliki (⌥⌘A). Możesz też upuścić je w dowolnym miejscu okna lub wkleić obraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexe arquivos (⌥⌘A). Você também pode soltá-los em qualquer lugar ou colar uma imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикрепить файлы (⌥⌘A). Их также можно перетащить в любое место окна, а изображение — вставить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya ekle (⌥⌘A). Dosyaları herhangi bir yere bırakabilir veya bir görüntü yapıştırabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкласти файли (⌥⌘A). Їх також можна перетягнути будь-куди або вставити зображення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加文件（⌥⌘A）。也可以将文件拖放到任意位置，或粘贴图像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加檔案（⌥⌘A）。你也可以將檔案拖放到任意位置，或貼上影像。"
          }
        }
      }
    },
