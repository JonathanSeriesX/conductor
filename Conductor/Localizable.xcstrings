    "What you delete, and status changes, land here and can be put back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما تحذفه، وتغييرات الحالة، يصل إلى هنا ويمكن استعادته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was Sie löschen, und Statusänderungen, landet hier und kann zurückgeholt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que eliminas, y los cambios de estado, llegan aquí y se pueden recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous supprimez, et les changements d’état, arrivent ici et peuvent être rétablis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो हटाते हैं, और स्थिति के बदलाव, यहाँ आते हैं और वापस लाए जा सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che elimini, e i cambi di stato, finiscono qui e possono essere ripristinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したものやステータスの変更はここに入り、元に戻せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você apaga, e as mudanças de status, vêm parar aqui e podem ser restaurados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что вы удаляете, и смены статуса попадают сюда, и их можно вернуть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, що ви видаляєте, і зміни статусу потрапляють сюди, і їх можна повернути."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的内容和状态更改都会到这里，可以恢复。"
          }
        }
      }
    },
    "Who is watching; right-click to watch or stop" : {
      "localizations" : {
        "ar" : {
