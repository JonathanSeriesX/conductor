    "New lists start on the Open status chip; switch any list to Any status or Done from the chip." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ القوائم الجديدة بعامل تصفية الحالة «مفتوحة»؛ ويمكن تحويل أي قائمة إلى «أي حالة» أو «مكتملة» منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Listen starten mit dem Statusfilter „Offen“; über den Filter lässt sich jede Liste auf „Alle Status“ oder „Fertig“ umstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas nuevas empiezan con el filtro de estado Abiertas; desde ese filtro puedes cambiar cualquier lista a Cualquier estado o a Listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles listes démarrent sur le filtre d’état « Ouvert » ; passez une liste à « Tous les états » ou « Terminé » depuis ce filtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई सूचियाँ “खुले” स्थिति चिप से शुरू होती हैं; किसी भी सूची को चिप से “कोई भी स्थिति” या “पूर्ण” पर बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi elenchi partono dal filtro di stato Aperti; da lì puoi passare a Qualsiasi stato o Fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいリストは「未完了」ステータスチップで始まります。チップから「すべてのステータス」や「完了」に切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 목록은 '미완료' 상태 칩으로 시작합니다. 칩에서 '모든 상태' 또는 '완료'로 전환할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe listy zaczynają od filtru statusu „Otwarte”; każdą listę można przełączyć na „Dowolny status” lub „Gotowe” w tym samym filtrze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas listas começam com o filtro de status Em aberto; mude qualquer lista para Qualquer status ou Concluído no próprio filtro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые списки открываются с фильтром статуса «Открытые»; переключить любой список на «Любой статус» или «Готово» можно в этом же фильтре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni listeler Açık durum çipiyle başlar; herhangi bir listeyi çipten Tüm durumlar veya Bitti olarak değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові списки відкриваються з фільтром статусу «Відкриті»; у фільтрі будь-який список можна перемкнути на «Будь-який статус» або «Готово»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新列表默认使用“未完成”状态筛选；可通过该筛选将任一列表切换为“任意状态”或“已完成”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新列表預設使用「未完成」狀態篩選；可從該篩選將任一列表切換為「任何狀態」或「完成」。"
          }
        }
      }
    },
