    "Attach files. You can also drop them anywhere or paste an image." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرفاق ملفات. يمكنك أيضًا إفلاتها في أي مكان أو لصق صورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien anhängen. Sie können sie auch an beliebiger Stelle ablegen oder ein Bild einsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjunta archivos. También puedes soltarlos en cualquier parte o pegar una imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joindre des fichiers. Vous pouvez aussi les déposer n’importe où ou coller une image."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें अटैच करें। आप उन्हें कहीं भी ड्रॉप कर सकते हैं या कोई इमेज पेस्ट कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega file. Puoi anche trascinarli in un punto qualsiasi o incollare un’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを添付します。どこにでもドロップしたり、画像をペーストしたりすることもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anexe arquivos. Você também pode soltá-los em qualquer lugar ou colar uma imagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикрепить файлы. Их также можно перетащить в любое место окна, а изображение — вставить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкласти файли. Їх також можна перетягнути будь-куди або вставити зображення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加文件。也可以将文件拖放到任意位置，或粘贴图像。"
          }
        }
      }
    },
    "Attach Files…" : {
      "localizations" : {
        "ar" : {
