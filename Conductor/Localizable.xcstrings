    "The account this board belongs to is no longer signed in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل الخروج من الحساب الذي تتبع له هذه اللوحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Account dieses Boards ist nicht mehr angemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta a la que pertenece este tablero ya no tiene la sesión iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte auquel appartient ce tableau n’est plus connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस खाते का यह बोर्ड है, वह अब साइन इन नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’account a cui appartiene questa board non è più connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボードのアカウントはサインアウトされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보드가 속한 계정이 로그아웃되었습니다."
