    "Reversible changes you made are kept here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التغييرات التي أجريتها ويمكن التراجع عنها تُحفظ هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Änderungen, die sich rückgängig machen lassen, werden hier aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios que has hecho y que se pueden deshacer se guardan aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications que vous avez faites et qui peuvent être annulées sont conservées ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके द्वारा किए गए बदलाव, जिन्हें पूर्ववत किया जा सकता है, यहाँ रखे जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche che hai fatto e che si possono annullare vengono conservate qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行った変更のうち、取り消せるものはここに保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
