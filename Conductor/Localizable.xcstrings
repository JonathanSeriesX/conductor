    "Jira keeps this list from the issues you open on the web. Issues opened in Conductor don't count." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنشئ Jira هذه القائمة من المشكلات التي تفتحها على الويب. لا تُحتسب المشكلات المفتوحة في Conductor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira erstellt diese Liste aus den Vorgängen, die Sie im Web öffnen. In Conductor geöffnete Vorgänge zählen nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira genera esta lista a partir de las incidencias que abres en la web. Las incidencias abiertas en Conductor no cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira tient cette liste à partir des tickets que vous ouvrez sur le web. Les tickets ouverts dans Conductor ne comptent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira यह सूची वेब पर आपके खोले गए इश्यू से बनाता है। Conductor में खोले गए इश्यू इसमें नहीं गिने जाते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira compila questo elenco con i ticket che apri sul web. I ticket aperti in Conductor non vengono conteggiati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリストは、Webで開いた課題をもとにJiraが管理しています。Conductorで開いた課題は含まれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jira monta esta lista com os itens que você abre na web. Itens abertos no Conductor não contam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira составляет этот список по задачам, открытым в браузере. Задачи, открытые в Conductor, не учитываются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira формує цей список із задач, які ви відкриваєте у вебверсії. Задачі, відкриті в Conductor, не враховуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此列表由 Jira 根据你在网页上打开的事务维护，在 Conductor 中打开的事务不计入。"
          }
        }
      }
    },
