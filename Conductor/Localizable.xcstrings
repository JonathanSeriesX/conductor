    "New lists start on the Open status chip; switch any list to Any status or Done from the chip." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ القوائم الجديدة بعامل تصفية الحالة «مفتوحة»؛ ويمكن تحويل أي قائمة إلى «أي حالة» أو «مكتملة» منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Listen starten mit dem Statusfilter „Offen“; über den Filter lässt sich jede Liste auf „Alle Status“ oder „Fertig“ umstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas nuevas empiezan con el filtro de estado Abiertas; desde ese filtro puedes cambiar cualquier lista a Cualquier estado o a Listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles listes démarrent sur le filtre d’état « Ouvert » ; passez une liste à « Tous les états » ou « Terminé » depuis ce filtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई सूचियाँ “खुले” स्थिति चिप से शुरू होती हैं; किसी भी सूची को चिप से “कोई भी स्थिति” या “पूर्ण” पर बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi elenchi partono dal filtro di stato Aperti; da lì puoi passare a Qualsiasi stato o Fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいリストは「未完了」ステータスチップで始まります。チップから「すべてのステータス」や「完了」に切り替えられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas listas começam com o filtro de status Em aberto; mude qualquer lista para Qualquer status ou Concluído no próprio filtro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
