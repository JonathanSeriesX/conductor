    "Jira won't list a whole site at once. Choose a project, a status, a person or a scope, or type a search." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعرض Jira موقعًا كاملًا دفعة واحدة. اختر مشروعًا أو حالة أو شخصًا أو نطاقًا، أو اكتب عبارة بحث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira listet keine ganze Site auf einmal auf. Wählen Sie ein Projekt, einen Status, eine Person oder einen Bereich aus oder geben Sie einen Suchbegriff ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira no lista un sitio entero de una vez. Elige un proyecto, un estado, una persona o un ámbito, o escribe una búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira ne liste pas un site entier d’un coup. Choisissez un projet, un état, une personne ou une portée, ou saisissez une recherche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira पूरी साइट एक साथ सूचीबद्ध नहीं करता। कोई प्रोजेक्ट, स्थिति, व्यक्ति या दायरा चुनें, या खोज टाइप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira non elenca un intero sito in una volta. Scegli un progetto, uno stato, una persona o un ambito, oppure digita una ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiraではサイト全体を一度に一覧表示できません。プロジェクト、ステータス、ユーザー、範囲のいずれかを選択するか、検索語を入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jira não lista um site inteiro de uma vez. Escolha um projeto, um status, uma pessoa ou um escopo, ou digite uma pesquisa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira не выдает весь сайт сразу. Выберите проект, статус, человека или область либо введите запрос."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira не показує весь сайт одразу. Виберіть проєкт, статус, людину чи область або введіть пошуковий запит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jira 不会一次列出整个站点。请选择项目、状态、人员或范围，或者输入搜索内容。"
          }
        }
      }
    },
    "Keep these filters and search in the sidebar (⌘S)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاحتفاظ بعوامل التصفية والبحث هذه في الشريط الجانبي (⌘S)"
          }
        },
        "de" : {
          "stringUnit" : {
