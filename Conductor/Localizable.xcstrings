    "Try to reconnect now. Conductor also retries on its own every 20 seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول إعادة الاتصال الآن. يعيد Conductor المحاولة تلقائيًا كل 20 ثانية أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt erneut verbinden. Conductor versucht es außerdem alle 20 Sekunden selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intentar reconectar ahora. Conductor también lo reintenta automáticamente cada 20 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenter de se reconnecter maintenant. Conductor réessaie aussi de lui-même toutes les 20 secondes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी फिर से कनेक्ट करने का प्रयास करें। Conductor हर 20 सेकंड में खुद भी पुनः प्रयास करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a riconnetterti ora. Conductor riprova comunque da solo ogni 20 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ再接続します。Conductorは20秒ごとに自動で再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 다시 연결을 시도합니다. Conductor는 20초마다 자동으로 재시도합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj połączyć się ponownie teraz. Conductor ponawia próbę sam co 20 sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente reconectar agora. O Conductor também tenta de novo sozinho a cada 20 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переподключиться сейчас. Conductor также сам повторяет попытку каждые 20 секунд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi yeniden bağlanmayı dene. Conductor ayrıca her 20 saniyede bir kendisi dener."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробувати під’єднатися зараз. Conductor також автоматично повторює спробу кожні 20 секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即尝试重新连接。Conductor 也会每 20 秒自动重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即嘗試重新連線。Conductor 也會每 20 秒自動重試。"
          }
        }
      }
    },
