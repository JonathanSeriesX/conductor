    "The current chips, search and sort order, under %@ in the sidebar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عوامل التصفية الحالية والبحث وترتيب الفرز، ضمن %@ في الشريط الجانبي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuellen Filter, Suche und Sortierung unter %@ in der Seitenleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los filtros, la búsqueda y el orden actuales, bajo %@ en la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les filtres, la recherche et l’ordre de tri actuels, sous %@ dans la barre latérale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा चिप, खोज और क्रम, साइडबार में %@ के अंतर्गत।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I filtri attuali, la ricerca e l’ordinamento, sotto %@ nella barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のチップ、検索、並べ替え順を、サイドバーの「%@」に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 칩, 검색 및 정렬 순서를 사이드바의 %@ 아래에 저장합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżące filtry, wyszukiwanie i kolejność sortowania, w sekcji „%@” na pasku bocznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os filtros, a pesquisa e a ordem de classificação atuais, em %@ na barra lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие фильтры, поиск и порядок сортировки будут сохранены в разделе «%@» боковой панели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli çipler, arama ve sıralama düzeni; kenar çubuğunda %@ altında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточні фільтри, пошук і порядок сортування — у розділі «%@» на бічній панелі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前筛选条件、搜索和排序方式，将保存在边栏的“%@”下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的篩選條件、搜尋和排序順序，會儲存在側邊欄的「%@」下。"
          }
        }
      }
    },
    "The token is removed from the Keychain. Cached issues stay until the cache is cleared." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إزالة الرمز من سلسلة المفاتيح. تبقى المشكلات المخزنة مؤقتًا حتى يتم مسح ذاكرة التخزين المؤقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Token wird aus dem Schlüsselbund entfernt. Zwischengespeicherte Vorgänge bleiben erhalten, bis der Cache geleert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token se elimina del Llavero. Las incidencias en caché se conservan hasta que se borre la caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton est supprimé du trousseau. Les tickets en cache sont conservés jusqu’à ce que le cache soit vidé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोकन कीचेन से हटा दिया जाता है। कैश किए गए इश्यू तब तक रहते हैं जब तक कैश साफ़ नहीं किया जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il token viene rimosso dal Portachiavi. I ticket nella cache restano finché la cache non viene svuotata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンはキーチェーンから削除されます。キャッシュされた課題は、キャッシュを消去するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰이 키체인에서 제거됩니다. 캐시된 이슈는 캐시를 지울 때까지 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token zostanie usunięty z pęku kluczy. Zgłoszenia w pamięci podręcznej pozostaną do jej wyczyszczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token é removido das Chaves. Os itens em cache permanecem até que o cache seja limpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен будет удален из Связки ключей. Задачи в кэше останутся до его очистки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirteç Anahtar Zinciri'nden kaldırılır. Önbellekteki konular, önbellek temizlenene kadar kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен буде вилучено з в’язки. Кешовані задачі зберігатимуться, доки кеш не буде очищено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "令牌将从钥匙串中移除。缓存的事务会保留，直到清除缓存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權杖會從鑰匙圈中移除。快取的問題會保留，直到清除快取為止。"
          }
        }
      }
    },
    "This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer."
          }
        },
