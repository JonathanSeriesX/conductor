    "Covers issues you are assigned to, reported or are watching, on every account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل المشكلات المُسندة إليك أو التي أبلغت عنها أو تراقبها، في كل الحسابات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Vorgänge, die Ihnen zugewiesen sind, die Sie gemeldet haben oder die Sie beobachten – in allen Accounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye las incidencias que tienes asignadas, que informaste o que observas, en todas las cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concerne les tickets qui vous sont assignés, que vous avez signalés ou que vous observez, sur tous les comptes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर खाते पर वे इश्यू शामिल हैं जो आपको असाइन हैं, जिन्हें आपने रिपोर्ट किया है या जिन्हें आप वॉच कर रहे हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riguarda i ticket assegnati a te, segnalati da te o che osservi, su tutti gli account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアカウントで、自分が担当、報告、またはウォッチしている課題が対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 계정에서 내가 담당하거나 보고했거나 주시 중인 이슈가 대상입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy zgłoszeń przypisanych do ciebie, zgłoszonych lub obserwowanych przez ciebie, na wszystkich kontach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui os itens atribuídos a você, relatados por você ou que você segue, em todas as contas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Касается задач во всех аккаунтах, где вы исполнитель, автор или наблюдатель."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm hesaplarda size atanan, raporladığınız veya izlediğiniz konuları kapsar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стосується задач, де ви виконавець, автор або спостерігач, в усіх облікових записах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "涵盖所有账户中分配给你、由你报告或你关注的事务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "涵蓋所有帳號中指派給你、由你報告或你關注的問題。"
          }
        }
      }
    },
