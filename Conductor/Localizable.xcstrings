    "Attach Files" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرفاق ملفات"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien anhängen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjuntar archivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joindre des fichiers"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइलें अटैच करें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allega file"
          }
        },
